# Client-side Supabase values (safe to expose in the browser; never put the service role key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional: enables Turnstile on the magic-link form
VITE_TURNSTILE_SITE_KEY=

# Vercel server-side values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=https://juntadirectiva.iapacks.com
DEVICE_COOKIE_SECRET=replace-with-a-long-random-secret
TURNSTILE_SECRET_KEY=
